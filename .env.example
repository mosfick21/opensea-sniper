# Copy this file to .env and fill it in.

# --- Required ---
OPENSEA_API_KEY=
# Buyer wallet private key (keep only what you plan to spend in it)
PRIVATE_KEY=

# --- Optional faster RPC, per chain: RPC_<CHAIN>=url (comma separated for more than one) ---
# The chain is detected from the collection. Public RPCs are used if nothing is set.
# RPC_BASE=https://base-mainnet.g.alchemy.com/v2/your_key

# --- Limits ---
# Total coin (ETH, POL, ...) the bot may spend (empty = no limit)
MAX_SPEND=

# --- Sources (gas is picked automatically) ---
# Live OpenSea stream (fastest) + API polling as backup
USE_STREAM=true
POLL_MS=1000

# true = find and prepare buys but never send. Set false to buy for real.
DRY_RUN=true
